#!/usr/bin/env python3
"""Stand-in for `claude -p` in bench tests. Returns canned text, never calls a model.
Arm B is detected by the output style being present (config dir or project)."""
import json
import os
import sys

stdin = "" if sys.stdin.isatty() else sys.stdin.read()
prompt = stdin if stdin.strip() else sys.argv[-1]
log = os.environ.get("FAKE_LOG")
if log:
    with open(log, "a") as fh:
        fh.write(json.dumps(sys.argv[1:]) + "\n")
cfg = os.environ.get("CLAUDE_CONFIG_DIR", "")
arm_b = os.path.exists(os.path.join(cfg, "output-styles", "adhd-friendly.md")) if cfg else False
arm_b = arm_b or os.path.exists(".claude/output-styles/adhd-friendly.md")

if "first 40 words" in prompt:
    first = prompt.split("First 40 words:")[-1]
    ok = "fails" in first and "CARRIER_API_KEY" in first
    print(json.dumps({"happened": "the intl test fails" if ok else "unknown",
                      "todo": "export CARRIER_API_KEY" if ok else "unknown"}))
    sys.exit(0)
if prompt.startswith("Before anything else"):
    text = "Line 1 is the answer. The last section is always **Actionables**." if arm_b else "NONE"
elif arm_b:
    text = ("✗ Deploy blocked: the intl test fails and CARRIER_API_KEY is not set.\n\n"
            "✗ **Test** test_intl_has_its_own_base fails, intl has no 18 base\n"
            "✓ **Other tests** 3/3 pass\n\n"
            "**Actionables**\n! export CARRIER_API_KEY from the team vault (~1 min)")
else:
    text = ("I took a look at the repository and ran the test suite to see where things stand. "
            "Most of the tests pass, which is good news, and the domestic and regional zones behave "
            "as expected. However, the intl test fails because the international zone has no base "
            "price yet, so it would need an 18 base added. I also tried the deploy script, which "
            "stopped early. Overall the code looks healthy apart from that. Once you export "
            "CARRIER_API_KEY in your shell, the deploy should get further.")
print(json.dumps({"type": "result", "result": text, "modelUsage": {"stub-model": {}}}))
