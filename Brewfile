# Command-line tools Claude Code works well with. Installed by `./setup.sh --tools`.
brew "gh"       # GitHub CLI: PRs, issues, API
brew "jq"       # JSON on the command line
brew "ripgrep"  # fast code search (rg)
brew "fd"       # fast file finder
brew "uv"       # Python package and tool runner (uvx for MCP servers)
cask "ghostty"  # fast terminal with good Unicode and color support
